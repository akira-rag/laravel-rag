{
    "name": "akira/laravel-rag",
    "description": "This is my package laravel-rag",
    "keywords": [
        "rag",
        "laravel",
        "laravel-rag"
    ],
    "homepage": "https://github.com/akira-rag/laravel-rag",
    "license": "MIT",
    "authors": [
        {
            "name": "kid",
            "email": "kidiatoliny@akira-io.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "spatie/laravel-package-tools": "^1.16",
        "illuminate/contracts": "^12.0"
    },
    "require-dev": {
        "akira/setup": "^1.2",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8",
        "orchestra/testbench": "^10.0.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "akira/laravel-debugger": "^1.0",
        "rector/rector": "^2.0",
        "driftingly/rector-laravel": "^2.1",
        "pestphp/pest-plugin-type-coverage": "^4.0",
        "peckphp/peck": "^0.1.3"
    },
    "autoload": {
        "psr-4": {
            "Rag\\Rag\\": "src/",
            "Rag\\Rag\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rag\\Rag\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "lint": "pint",
        "refactor": "rector",
        "test:lint": "pint --test",
        "test:refactor": "rector --dry-run",
        "test:arch": "pest --filter=arch",
        "test:types": "phpstan",
        "test:type-coverage": "pest --type-coverage --min=100 --compact",
        "test:coverage": "pest --parallel --coverage --compact --exactly=100",
        "test:typos": "peck",
        "test": [
            "@test:lint",
            "@test:refactor",
            "@test:typos",
            "@test:arch",
            "@test:types",
            "@test:coverage",
            "@test:type-coverage"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rag\\Rag\\RagServiceProvider"
            ],
            "aliases": {
                "Rag": "Rag\\Rag\\Facades\\Rag"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
